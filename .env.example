# Hosted libSQL / Turso database (REQUIRED in production, e.g. Vercel).
# Get these by creating a free database at https://turso.tech:
#   turso db create uniabuja-weather
#   turso db show uniabuja-weather --url        # -> TURSO_DATABASE_URL
#   turso db tokens create uniabuja-weather     # -> TURSO_AUTH_TOKEN
#
# For local development, copy this file to .env.local and fill in real values
# (or leave them unset — the app falls back to a local file DB at data/app.db).
# NEVER put real secrets in this file: it is committed to git.

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token
